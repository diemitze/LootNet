<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>LootNetServer</RootNamespace>
    <Version>1.0.9</Version>
    <Authors>user</Authors>
    <Company>user</Company>
    <Product>LootNetServer</Product>
    <Description></Description>
    <Copyright>Copyright © user</Copyright>
    <RepositoryUrl></RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
  </ItemGroup>

  <!-- Live-test deploy only. SPT 4.0 C# server mods carry their metadata in the DLL
       (ModMetadata : AbstractModMetadata) — no package.json. The release zip is built by
       the client project (LootNet.csproj), which bundles this DLL under SPT/user/mods. -->
  <Target Name="DeployServerMod" AfterTargets="Build">
    <ItemGroup>
      <FikaServerInstall Include="D:\SPT Fika dev\SPT\user\mods" />
      <FikaServerInstall Include="D:\SPT fika dev player2\SPT\user\mods" />
    </ItemGroup>
    <MakeDir Directories="%(FikaServerInstall.Identity)\LootNetServer" Condition="Exists('%(FikaServerInstall.Identity)')" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="%(FikaServerInstall.Identity)\LootNetServer"
          SkipUnchangedFiles="false"
          Condition="Exists('%(FikaServerInstall.Identity)')" />
    <Message Text="--- Server mod deployed to Fika installs ---" Importance="high" />
  </Target>
</Project>
