<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LootNetFika</AssemblyName>
    <RootNamespace>LootNet.Fika</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>1.1.1</AssemblyVersion>
    <FileVersion>1.1.1</FileVersion>
    <Deterministic>true</Deterministic>
    <FikaInstall>D:\SPT 4.1</FikaInstall>
    <SptInstall>D:\SPT 4.1</SptInstall>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base mod: provides RaidStats, RaidTracker.OnLocalSummaryBuilt, TeamSummaryStore -->
    <ProjectReference Include="..\LootNet.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Fika.Core">
      <HintPath>$(FikaInstall)\BepInEx\plugins\Fika\Fika.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptInstall)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptInstall)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptInstall)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptInstall)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptInstall)\BepInEx\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptInstall)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptInstall)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptInstall)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployFikaPlugin" AfterTargets="Build">
    <MakeDir Directories="$(SptInstall)\BepInEx\plugins\LootNet" Condition="Exists('$(SptInstall)\BepInEx')" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(SptInstall)\BepInEx\plugins\LootNet"
          SkipUnchangedFiles="false"
          Retries="3"
          RetryDelayMilliseconds="500"
          Condition="Exists('$(SptInstall)\BepInEx')" />
    <!-- player2 client install -->
    <MakeDir Directories="D:\SPT fika dev player2\BepInEx\plugins\LootNet" Condition="Exists('D:\SPT fika dev player2\BepInEx')" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="D:\SPT fika dev player2\BepInEx\plugins\LootNet"
          SkipUnchangedFiles="false"
          Retries="3"
          RetryDelayMilliseconds="500"
          Condition="Exists('D:\SPT fika dev player2\BepInEx')" />
  </Target>

</Project>
